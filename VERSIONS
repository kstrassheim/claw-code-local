# claw-code-local version pins — single source of truth.
# Read by .github/workflows/validate.yml and deploy.yml.
# Bump a value here and a PR / merge will rebuild the image with it.

# Upstream openclaw base image (FROM in builder/Dockerfile).
# Tag matches https://github.com/openclaw/openclaw releases. The deploy /
# validate workflows pull ghcr.io/openclaw/openclaw:<this minus v-prefix>
# and re-tag it locally as openclaw-base:<this with v-prefix>.
#
# Upstream publishes CORRECTION releases on a tag as `-1`, `-2`, ... so the
# newest release of a line is not the highest-looking version string: at the
# time of writing v2026.6.34 was published four days AFTER v2026.7.1-2 and is
# a backport on an older line. Read the release list, not the dates.
#
# Whatever this is set to must exist on GHCR with a linux/arm64 entry, since
# the deploy mirrors it before building. A tag that exists on GitHub but not
# on the registry fails the mirror step AFTER the version has been bumped.
OPENCLAW_UPSTREAM=v2026.7.1-2

# Our build number on top of the upstream tag. The deploy skips the whole
# build when this tag already exists in the registry, so it is effectively a
# cache key: re-pushing the same value ships nothing.
#
# Deliberately NOT mirrored into k8s/kustomization.yaml by hand. The deploy
# workflow rewrites that pin AFTER the image is pushed and commits it, which
# is the ordering that matters — a manifest naming an image that does not
# exist yet leaves Argo CD pulling a missing tag for the length of the build.
OPENCLAW_VERSION=v2026.7.1-2.24

# Tools baked into the openclaw image.
# All values mirror claw-code/VERSIONS (the Azure sibling) — known-working
# combinations against the corresponding tools' GitHub Releases / vendor
# CDNs. Bump deliberately; verify the artifact URL exists for arm64
# before pushing (the build pulls these from upstream CDNs at image
# build time, so a wrong value 404s mid-build).
GH_CLI_VERSION=2.98.0
GITHUB_MCP_SERVER_VERSION=1.10.1
GLAB_VERSION=1.97.0
GITLAB_MCP_VERSION=0.7.0
# Gitea: the `tea` CLI and the official MCP server. Unlike the two lines
# above, these are actually consumed — builder/Dockerfile declares an ARG
# for each and installs them. Assets are published on gitea.com, arm64.
TEA_VERSION=0.15.1
GITEA_MCP_VERSION=1.6.0
# Azure DevOps: the official MCP server (npm) and the `azure-devops`
# extension for the Azure CLI already in this image. The extension has
# no independent pin — `az extension add` resolves against the installed
# az, which is why only the MCP is listed here.
AZDO_MCP_VERSION=2.9.0
TERRAFORM_VERSION=1.15.9
TERRAFORM_MCP_VERSION=1.2.0
# OpenTofu: the fork of Terraform under the Linux Foundation, and the registry
# MCP that goes with it. Both are here rather than one replacing terraform:
# a project's state and lockfile are written by whichever binary made them,
# and the bot works on repositories that have chosen either.
OPENTOFU_VERSION=1.12.6
OPENTOFU_MCP_VERSION=0.1.5
CODE_SERVER_VERSION=4.133.0
# mermaid-cli, the renderer behind `mermaid-render`. It drives a headless
# browser, and puppeteer would fetch its OWN Chromium — the Dockerfile points
# it at the system one instead (PUPPETEER_EXECUTABLE_PATH), so this pin must
# stay compatible with the chromium Debian ships. A mermaid-cli that requires
# a newer Chrome than the base image has fails at render time, not at build.
MERMAID_CLI_VERSION=11.16.0
AWS_CLI_VERSION=2.36.29
GCLOUD_VERSION=567.0.0
ALIYUN_CLI_VERSION=3.4.11

# git-lfs. Target repositories keep large binary assets under LFS, and without
# the client a clone hands the agent ~130-byte pointer files instead of the
# content. That does not fail loudly — it looks like corrupt data, and any
# commit touching such a file overwrites the pointer and destroys the object
# for everyone. Baked into the IMAGE because the agent runs as uid 1000 and
# cannot write to /usr/local/bin at runtime.
# Bump hazard: the release asset is named git-lfs-linux-<arch>-v<version>, and
# the tarball unpacks into a git-lfs-<version>/ directory — both carry the
# version, so a wrong value 404s and a renamed layout breaks the install path.
GIT_LFS_VERSION=3.7.1

# kubelogin — the Entra credential plugin kubectl execs when a kubeconfig comes
# from `az aks get-credentials` against an Entra-integrated AKS cluster (see
# builder/aks-login). kubectl alone cannot authenticate to those clusters: every
# call dies with `exec: "kubelogin": executable file not found in $PATH`.
# Bump hazard: the per-platform zip nests the binary under bin/linux_<arch>/,
# so the unzip path has to keep matching that layout.
KUBELOGIN_VERSION=0.2.19

# Code scanners behind mcp.servers.security + mcp.servers.semgrep — SAST,
# dependency CVEs, secret detection and PowerShell lint for the reviewer.
#
# Bump hazard (semgrep / semgrep-mcp): the two pin INCOMPATIBLE exact versions
# of the `mcp` package (semgrep 1.172.0 wants mcp==1.23.3, semgrep-mcp 0.9.0
# wants mcp==1.12.2), so they can never resolve in one environment. They are
# installed into two separate virtualenvs for that reason; bumping either one
# alone is safe, merging the venvs is not.
SEMGREP_VERSION=1.174.0
SEMGREP_MCP_VERSION=0.9.0
BANDIT_VERSION=1.9.4
PIP_AUDIT_VERSION=2.10.1
# gitleaks release assets are gitleaks_<version>_linux_<arch>.tar.gz — note the
# version appears WITHOUT the leading v inside the filename but WITH it in the
# tag path.
GITLEAKS_VERSION=8.30.1
# PowerShell 7 + PSScriptAnalyzer. The pwsh tarball is
# powershell-<version>-linux-arm64.tar.gz; the x86_64 asset is spelled
# `linux-x64`, not `linux-amd64`, so an arch-substituted URL is not symmetric.
PWSH_VERSION=7.6.5
PSSCRIPTANALYZER_VERSION=1.25.0

# Azure data-platform tooling: PowerShell runbooks with Pester tests, and
# SSDT/dacpac database projects the solver must be able to build and publish
# BEFORE it pushes. Only the four Az modules actually used are installed, not
# the Az meta-module (several hundred MB of provider surface never touched).
PESTER_VERSION=6.1.0
# DOTNET_SDK_VERSION is a dotnet-install.sh CHANNEL, not an exact version — it
# must match the major.minor a project's global.json pins (`rollForward:
# latestFeature` on 8.0.x stays inside 8.0 and rejects a 10.0 SDK). Installed
# by script rather than apt because packages.microsoft.com ships no
# dotnet-sdk-8.0 for arm64 at all — an apt install fails outright.
DOTNET_SDK_VERSION=8.0
# SqlPackage is a .NET global tool from nuget.org; the pin is the NuGet package
# version of microsoft.sqlpackage and must be supported by the SDK channel
# above.
SQLPACKAGE_VERSION=170.4.83
AZ_VERSION=16.2.0

# Live DAST scanners behind mcp.servers.pentest, used by the deployment tester
# against the project's own authorised dev deployment only.
NUCLEI_VERSION=3.11.1
# nuclei community templates, baked in as a PINNED static release tarball
# fetched from codeload. They are deliberately NOT fetched with
# `nuclei -update-templates`: that resolves the version through a GitHub API
# call which can silently no-op in CI — exiting 0 having downloaded nothing —
# and ships a template-less scanner that reports a clean scan it never
# performed. The build fails hard if the extracted tree holds no templates.
# Bump hazard: this is the nuclei-templates repo's OWN version line (10.x),
# unrelated to NUCLEI_VERSION above; they are bumped independently.
NUCLEI_TEMPLATES_VERSION=10.4.7
# testssl.sh is a bash script, installed from the tag's source tarball.
TESTSSL_VERSION=3.2.4

# MongoDB driver for the planning store — the only pip package installed into
# the image's SYSTEM python (the scanners above live in their own virtualenvs).
# Installed by builder/Dockerfile with --break-system-packages (Debian's
# python3 is externally managed). Keep the ARG default in that pip layer equal
# to this value. arm64 wheels must exist for the pinned release, or the build
# falls back to compiling from source; verify before bumping.
PYMONGO_VERSION=4.17.0
